---
import Layout from '~/layouts/Layout.astro';

const apps = [
  {
    name: "Cling",
    description: "Fuzzy-search your Mac from the shelf when Cling is already installed. Partial names, operators, results in under 100ms. Free forever for Home and Applications.",
    url: "https://lowtechguys.com/cling/",
    icon: "https://lowtechguys.com/static/img/cling-icon.png",
  },
  {
    name: "Clop",
    description: "Shrink images, video, and PDFs on the shelf in one click.",
    url: "https://lowtechguys.com/clop/#integration",
    icon: "https://lowtechguys.com/static/img/clop-icon.png",
  },
  {
    name: "Dropshare",
    description: "Upload a shelf file and share a link. 29+ cloud services.",
    url: "https://dropshare.app/",
    icon: "https://dropshare.app/logo.png",
  },
  {
    name: "Popclip",
    description: "Send the selected text straight onto the shelf.",
    url: "https://www.popclip.app/extensions/x/p8rrp7",
    icon: "https://www.popclip.app/icon128.png",
  },
];
---

<Layout metadata={{ title: 'Dockside integrations' }}>
<section style="padding: 2rem 1rem; text-align: center;">
  <h2 style="font-size: 2.0rem; font-weight: bold; margin-bottom: 1.5rem;">Dockside integrates with these amazing apps for utilities</h2>
  <ul style="list-style: none; padding: 0; max-width: 600px; margin: 0 auto;">
    {apps.map((app) => (
      <li
        style="display: flex; align-items: center; padding: 1rem; margin-bottom: 1rem; border: 1.5px solid #d7d7d7; border-radius: 8px; background-color: #efefef;"
      >
        <img
          src={app.icon}
          alt={`${app.name} Icon`}
          style="width: 44px; height: 44px; margin-right: 12px; border-radius: 50%;"
        />
        <div style="text-align: left;">
          <b>
            <a href={app.url} target="_blank" rel="noopener noreferrer" style="text-decoration: none; color: #007BFF;">
              {app.name}
            </a>
          </b>
          <p style="margin: 0; font-size: 0.9rem; color: #555;">{app.description}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
</Layout>
